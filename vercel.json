{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "../public",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/v2/:path*",
      "destination": "/v2/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/v2/index.html"
    }
  ],
  "headers": [
    {
      "source": "/v2/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
