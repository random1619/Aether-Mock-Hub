# Required MongoDB connection string. Use a dedicated application database user in production.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Optional database name (default: aether_mocks)
MONGODB_DB=aether_mocks

# Required signing secret. Generate a high-entropy value, for example:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional token lifetime (default: 7d)
JWT_EXPIRES_IN=7d

# Optional allowed browser origins. Comma-separate multiple origins; default is *.
CORS_ORIGIN=https://your-frontend.example.com

# Optional server bind settings
PORT=8080
HOST=0.0.0.0
