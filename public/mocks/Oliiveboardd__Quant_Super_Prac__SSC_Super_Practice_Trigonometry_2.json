ext-align:center\">x</span></div>&nbsp;) - 3&nbsp;</div></p><p></p></span><span class=\"hqt\" style=\"display:none\"><p><div><div>&#2351;&#2342;&#2367; x = (&radic;6 + 2) &#2340;&#2341;&#2366; y =(&radic;6 &#8722; 2) &#2361;&#2376;, &#2340;&#2379;(&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">x</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">y</span></div>&nbsp;+&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">y</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">x</span></div>&nbsp;)(&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">x</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">y</span></div>&nbsp;+&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">y</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">x</span></div>&nbsp;) - 3&nbsp;</div></div></p></span>","options":["<span class=\"eqt\">42</span><span class=\"hqt\" style=\"display:none\">42</span>","<span class=\"eqt\">97</span><span class=\"hqt\" style=\"display:none\">97</span>","<span class=\"eqt\">35</span><span class=\"hqt\" style=\"display:none\">35</span>","<span class=\"eqt\">22</span><span class=\"hqt\" style=\"display:none\">22</span>"],"correct_option_id":1,"solution":"<p>Compute x/y:</p><p>Multiply numerator and denominator by (&radic;6 + 2):</p><p>&#8195;&#8195;x/y = ( (&radic;6 + 2)&#178; ) / ( (&radic;6)&#178; &#8722; 2&#178; )</p><p>&#8195;&#8195;&#8195;&#8195;= (6 + 4&radic;6 + 4) / (6 &#8722; 4)</p><p>&#8195;&#8195;&#8195;&#8195;= (10 + 4&radic;6) / 2 = 5 + 2&radic;6.</p><p>Similarly, compute y/x:</p><p>&#8195;&#8195;y/x = 5 &#8722; 2&radic;6.</p><p>Sum the two:</p><p>&#8195;&#8195;x/y + y/x = (5 + 2&radic;6) + (5 &#8722; 2&radic;6) = 10.</p><p>Then, (x/y + y/x)&#178; &#8722; 3 = 10&#178; &#8722; 3 = 100 &#8722; 3 = 97.</p><p>Option (b) is the correct answer.</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p><div>&nbsp;Find the simplified form of:&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">a<sup>5</sup> b<sup>3</sup> c<sup>7</sup></span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">a<sup>4</sup> b<sup>8</sup> c<sup>9</sup></span></div></div></p><p></p></span><span class=\"hqt\" style=\"display:none\"><p><div>&nbsp;&#2325;&#2366; &#2360;&#2352;&#2354;&#2368;&#2325;&#2371;&#2340; &#2352;&#2370;&#2346; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2352;&#2375;&#2306;:&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">a<sup>5</sup> b<sup>3</sup> c<sup>7</sup></span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"d