sup> - 2<sup>2</sup> x 4<sup>a</sup></span></div></div></p><p></p></span>","options":["<span class=\"eqt\">16</span><span class=\"hqt\" style=\"display:none\">16</span>","<span class=\"eqt\">64</span><span class=\"hqt\" style=\"display:none\">64</span>","<span class=\"eqt\">20</span><span class=\"hqt\" style=\"display:none\">20</span>","<span class=\"eqt\">24</span><span class=\"hqt\" style=\"display:none\">24</span>"],"correct_option_id":0,"solution":"<p><img width=107 height=39 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p24263/image063.png\"></p><p><img width=131 height=39 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p24263/image064.png\"></p><p><img width=92 height=52 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p24263/image065.png\"></p><p><img width=207 height=39 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p24263/image066.png\"></p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p><div><div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">&#8731;6589</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">1296<sup>1/4</sup></span></div>&nbsp;x&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">3</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">57</span></div>&nbsp;x 42 = ?&nbsp;</div></p><p></p></span><span class=\"hqt\" style=\"display:none\"><p><div><div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">&#8731;6589</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">1296<sup>1/4</sup></span></div>&nbsp;x&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">3</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">57</span></div>&nbsp;x 42 = ?&nbsp;</div></p><p></p></span>","options":["<span class=\"eqt\">7</span><span class=\"hqt\" style=\"display:none\">7</span>","<span class=\"eqt\">16</span><span class=\"hqt\" style=\"display:none\">16</span>","<span class=\"eqt\">-3</span><span class=\"hqt\" style=\"display:none\">-3</span>","<span class=\"eqt\">17</span><span class=\"hqt\" style=\"display:none\">17</span>"],"correct_option_id":0,"solution":"<p>&#8731;6859 = 19 (19<sup>3</sup> = 6859)</p><p>&radic;1296 = &radic;36 =6</p><p>(19 / 6)  X  (3 / 57)  X  42</p><p>= 42/6 = 7</p><p>Option (a) is the correct answer.</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p><div><div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">a<sup>7</sup>  b<sup>8</sup>  c<sup>7</sup></span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">a<sup>9</sup> b<sup>5</sup> c<sup>4</sup></span></div>&nbsp;in simplified form is:&nbsp;</div></p><p></p></span><span class=\"hqt\" style=\"display:none\"><p><div><div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">a<sup>7</sup>  b<sup>8</sup>  c<sup>7</sup></span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">a<sup>9</sup> b<sup>5</sup> c<sup>4</sup></span></div>&nbsp;&#2360;&#2352;&#2354;&#2368;&#2325;&#2371;&#2340; &#2352;&#2370;&#2346; &#2350;&#2375;&#2306; &#2361;&#2376;:&nbsp;</div></p><p></p></span>","options":["<span class=\"eqt\">(a<sup>0</sup>) X (b<sup>2</sup>) X (c<sup>1</sup>)</span><span class=\"hqt\" style=\"display:none\">(a<sup>0</sup>) X (b<sup>2</sup>) X (c<sup>1</sup>)</span>","<span class=\"eqt\">(a<sup>-7</sup>) X (b<sup>2</sup>) X (c<sup>-4</sup>)</span><span class=\"hqt\" style=\"display:none\">(a<sup>-7</sup>) X (b<sup>2</sup>) X (c<sup>-4</sup>)</span>","<span class=\"eqt\">(a<sup>-2</sup>) X (b<sup>3</sup>) X (c<sup>3</sup>)</span><span class=\"hqt\" style=\"display:none\">(a<sup>-2</sup>) X (b<sup>3</sup>) X (c<sup>3</sup>)</span>","<span class=\"eqt\">(a<sup>-5</sup>) X (b<sup>-8</sup>) X (c<sup>0</sup>)</span><span class=\"hqt\" style=\"display:none\">(a<sup>-5</sup>) X (b<sup>-8</sup>) X (c<sup>0</sup>)</span>"],"correct_option_id":2,"solution":"<p>We need to simplify the expression (a<sup>7</sup>  X  b<sup>8</sup>  X  c<sup>7</sup>)/(a<sup>9</sup>  X  b<sup>5</sup> X  c<sup>4</sup>). Using the exponent rule for division, when dividing terms with the same base, subtract the exponents:</p><p>For a: a<sup>7</sup> / a<sup>9</sup> = a<sup>(7-9)</sup> = a<sup>-2</sup></p><p>For b: b<sup>8</sup> / b<sup>5</sup> = b<sup>(8 - 5)</sup> = b<sup>3</sup></p><p>For c: c<sup>7</sup> / c<sup>4</sup> = c<sup>(7 - 4)</sup> = c<sup>3</sup></p><p>So, the expression becomes:</p><p>a<sup>-2</sup>  X  b<sup>3</sup>  X  c<sup>3</sup></p><p>Option (c) is the correct answer.</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>If 2<sup>x</sup>+ 3<sup>y</sup> = 17 and 2<sup>x+2</sup> - 3<sup>y+1</sup> = 5, then:</p></span><span class=\"hqt\" style=\"display:none\"><p>&#2351;&#2342;&#2367; 2<sup>x</sup>+ 3<sup>y</sup> = 17 &#2324;&#2352; 2<sup>x+2</sup> - 3<sup>y+1</sup> = 5 &#2361;&#2376;, &#2340;&#2379;:</p></span>","options":["<span class=\"eqt\">x = 1, y = 3</span><span class=\"hqt\" style=\"display:none\">x = 1, y = 3</span>","<span class=\"eqt\">x = 3, y = 3</span><span class=\"hqt\" style=\"display:none\">x = 3, y = 3</span>","<span class=\"eqt\">x = 3, y = 2</span><span class=\"hqt\" style=\"display:none\">x = 3, y = 2</span>","<span class=\"eqt\">x = 1, y = 2</span><span class=\"hqt\" style=\"display:none\">x = 1, y = 2</span>"],"correct_option_id":2,"solution":"<p>2<sup>x+2</sup> - 3<sup>y+1</sup> = 5</p><p>2<sup>x </sup>*2<sup>2</sup> - 3<sup>y</sup>*3<sup>1</sup> = 5</p><p>4*2<sup>x</sup>  -  3*3<sup>y</sup> = 5 ---------(1)</p><p>and 2<sup>x</sup> + 3<sup>y</sup> = 17----------(2)</p><p>On solving equation (1) and (2) -</p><p>2<sup>x</sup> = 8 = 2<sup>3</sup>&rarr; x = 3</p><p>3<sup>y</sup> = 9 = 3<sup>2</sup>&rarr; y = 2</p>","marks":2,"section":null}]}