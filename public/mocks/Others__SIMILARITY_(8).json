2367;&#2351;&#2375; &#2332;&#2367;&#2360;&#2350;&#2375;&#2306; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2319;&#2305; &#2313;&#2360;&#2368; &#2346;&#2381;&#2352;&#2325;&#2366;&#2352; &#2360;&#2306;&#2348;&#2306;&#2343;&#2367;&#2340; &#2361;&#2376;&#2306; &#2332;&#2367;&#2360; &#2346;&#2381;&#2352;&#2325;&#2366;&#2352; &#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2360;&#2350;&#2370;&#2361; &#2325;&#2368; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2319;&#2305; &#2360;&#2306;&#2348;&#2306;&#2343;&#2367;&#2340; &#2361;&#2376;&#2306;&#2404;</p><p>(<b>&#2344;&#2379;&#2335;:</b> &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2323;&#2306; &#2325;&#2379; &#2313;&#2344;&#2325;&#2375; &#2328;&#2335;&#2325; &#2309;&#2306;&#2325;&#2379;&#2306; &#2350;&#2375;&#2306; &#2357;&#2367;&#2349;&#2366;&#2332;&#2367;&#2340; &#2325;&#2367;&#2319; &#2348;&#2367;&#2344;&#2366; &#2346;&#2370;&#2352;&#2381;&#2339; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2323;&#2306; &#2346;&#2352; &#2360;&#2306;&#2325;&#2381;&#2352;&#2367;&#2351;&#2366;&#2319;&#2305; &#2325;&#2368; &#2332;&#2366;&#2344;&#2368; &#2330;&#2366;&#2361;&#2367;&#2319;&#2404; &#2313;&#2342;&#2366;&#2361;&#2352;&#2339; &#2325;&#2375; &#2354;&#2367;&#2319;, 13 - 13 &#2346;&#2352; &#2360;&#2306;&#2325;&#2381;&#2352;&#2367;&#2351;&#2366;&#2319;&#2305; &#2332;&#2376;&#2360;&#2375; &#2325;&#2367; 13 &#2350;&#2375;&#2306; &#2332;&#2379;&#2337;&#2364;&#2344;&#2366;/&#2328;&#2335;&#2366;&#2344;&#2366; (&#2337;&#2367;&#2354;&#2368;&#2335;)/&#2327;&#2369;&#2339;&#2366; &#2325;&#2352;&#2344;&#2366; &#2310;&#2342;&#2367; &#2325;&#2368; &#2332;&#2366; &#2360;&#2325;&#2340;&#2368; &#2361;&#2376;&#2306;&#2404; 13 &#2325;&#2379; 1 &#2324;&#2352; 3 &#2350;&#2375;&#2306; &#2340;&#2379;&#2337;&#2364;&#2344;&#2366; &#2340;&#2341;&#2366; &#2347;&#2367;&#2352; 1 &#2324;&#2352; 3 &#2346;&#2352; &#2327;&#2339;&#2367;&#2340;&#2368;&#2351; &#2360;&#2306;&#2325;&#2381;&#2352;&#2367;&#2351;&#2366;&#2319;&#2305; &#2325;&#2352;&#2344;&#2375; &#2325;&#2368; &#2309;&#2344;&#2369;&#2350;&#2340;&#2367; &#2344;&#2361;&#2368;&#2306; &#2361;&#2376;&#2404;)</p><p>(6, 1296, 216)</p><p>(3, 81, 27)</p></span>","options":["<span class=\"eqt\">(7, 2401, 343)</span><span class=\"hqt\" style=\"display:none\">(7, 2401, 343)</span>","<span class=\"eqt\">(2, 10, 8)</span><span class=\"hqt\" style=\"display:none\">(2, 10, 8)</span>","<span class=\"eqt\">(11, 13541, 121)</span><span class=\"hqt\" style=\"display:none\">(11, 13541, 121)</span>","<span class=\"eqt\">(9, 6561, 727)</span><span class=\"hqt\" style=\"display:none\">(9, 6561, 727)</span>"],"correct_option_id":0,"solution":"<p>(6, 1296, 216) = (6 , 6x6x6x6 = 1296, 6x6x6 =216)</p><p>(3, 81, 27) = (3, 3x3x3x3 = 81, 3x3x3 =27)</p><p>Option (a): (7, 2401, 343) = (7, 7x7x7x7=2401, 7x7x7 =343)</p><p>Option (b): (2, 10, 8) = (2, 2x2x2x2=16, which is not equal to 10)</p><p>Option (c): (11, 13541, 121) = (11, 11x11x11x11=14641 which is not equal to 13541)</p><p>Option (d): (9, 6561, 727) = (9, 9x9x9x9= 6561, 9x9x9=729 which is not equal to 727)</p><p>So, Option (a) is the correct option that is related in the same way as are the numbers of the following sets.</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>Select the option in which the letters share the same relationship as that shared by the same pair of letters:</p><p>FJ:MR</p></span><span class=\"hqt\" style=\"display:none\"><p>&#2313;&#2360; &#2357;&#2367;&#2325;&#2354;&#2381;&#2346; &#2325;&#2366; &#2330;&#2351;&#2344; &#2325;&#2352;&#2375;&#2306; &#2332;&#2367;&#2360;&#2350;&#2375;&#2306; &#2309;&#2325;&#2381;&#2359;&#2352; &#2357;&#2361;&#2368; &#2360;&#2306;&#2348;&#2306;&#2343; &#2360;&#2366;&#2333;&#2366; &#2325;&#2352;&#2340;&#2375; &#2361;&#2376;&#2306; &#2332;&#2379; &#2309;&#2325;&#2381;&#2359;&#2352;&#2379;&#2306; &#2325;&#2368; &#2360;&#2350;&#2366;&#2344; &#2332;&#2379;&#2337;&#2364;&#2368; &#2342;&#2381;&#2357;&#2366;&#2352;&#2366; &#2360;&#2366;&#2333;&#2366; &#2325;&#2367;&#2351;&#2366; &#2332;&#2366;&#2340;&#2366; &#2361;&#2376;:</p><p>FJ:MR</p></span>","options":["<span class=\"eqt\">DK:LN</span><span class=\"hqt\" style=\"display:none\">DK:LN</span>","<span class=\"eqt\">CG:JO</span><span class=\"hqt\" style=\"display:none\">CG:JO</span>","<span class=\"eqt\">MP:WZ</span><span class=\"hqt\" style=\"display:none\">MP:WZ</span>","<span class=\"eqt\">JL:SV</span><span class=\"hqt\" style=\"display:none\">JL:SV</span>"],"correct_option_id":1,"solution":"<p>F+7=M</p><p>J+8=R</p><p>Similarly</p><p>C+7=J</p><p>G+8=O</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>Select the option which shows the term pair in which the terms are related to each other in the same way as that in the term pair given below.</p><p><b>UXA : FHJ</b></p></span><span class=\"hqt\" style=\"display:none\"><p>&#2313;&#2360; &#2357;&#2367;&#2325;&#2354;&#2381;&#2346; &#2325;&#2366; &#2330;&#2351;&#2344; &#2325;&#2368;&#2332;&#2367;&#2319; &#2332;&#2379; &#2319;&#2325; &#2320;&#2360;&#2375; &#2346;&#2342;-&#2351;&#2369;&#2327;&#2381;&#2350; &#2325;&#2379; &#2342;&#2352;&#2381;&#2358;&#2366;&#2340;&#2366; &#2361;&#2376; &#2332;&#2367;&#2360;&#2350;&#2375;&#2306; &#2346;&#2342; &#2319;&#2325; &#2342;&#2370;&#2360;&#2352;&#2375; &#2360;&#2375; &#2313;&#2360;&#2368; &#2346;&#2381;&#2352;&#2325;&#2366;&#2352; &#2360;&#2306;&#2348;&#2306;&#2343;&#2367;&#2340; &#2361;&#2376;&#2306; &#2332;&#2367;&#2360; &#2346;&#2381;&#2352;&#2325;&#2366;&#2352; &#2344;&#2368;&#2330;&#2375; &#2342;&#2367;&#2319; &#2327;&#2319; &#2346;&#2342;-&#2351;&#2369;&#2327;&#2381;&#2350; &#2319;&#2325; &#2342;&#2370;&#2360;&#2352;&#2375; &#2360;&#2375; &#2360;&#2306;&#2348;&#2306;&#2343;&#2367;&#2340; &#2361;&#2376;&#2306;&#2404;</p><p><b>UXA : FHJ</b></p></span>","options":["<span class=\"eqt\">FIL : QTW</span><span class=\"hqt\" style=\"display:none\">FIL : QTW</span>","<span class=\"eqt\">BEH : MOQ</span><span class=\"hqt\" style=\"display:none\">BEH : MOQ</span>","<span class=\"eqt\">KLM : YZA</span><span class=\"hqt\" style=\"display:none\">KLM : YZA</span>","<span class=\"eqt\">MPS : VYB</span><span class=\"hqt\" style=\"display:none\">MPS : VYB</span>"],"correct_option_id":1,"solution":"<p><b>U</b> (V W) <b>X</b> (Y Z) <b>A</b> (B C D E) <b>F</b> (G) <b>H</b> (I) <b>J.</b></p><p>Similarly, <b>B</b> (C D) <b>E</b> (F G) <b>H</b> (I J K L) <b>M</b> (N) <b>O</b> (P) <b>Q.</b></p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>Select the number pair in the options in which the two numbers are related in the same way as are the two numbers of the given number pair.</p><p>34 : 25</p></span><span class=\"hqt\" style=\"display:none\"><p>&#2357;&#2367;&#2325;&#2354;&#2381;&#2346;&#2379;&#2306; &#2350;&#2375;&#2306; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366; &#2332;&#2379;&#2337;&#2364;&#2368; &#2325;&#2366; &#2330;&#2351;&#2344; &#2325;&#2352;&#2375;&#2306; &#2332;&#2367;&#2360;&#2350;&#2375;&#2306; &#2342;&#2379; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2319;&#2306; &#2313;&#2360;&#2368; &#2340;&#2352;&#2361; &#2360;&#2375; &#2360;&#2306;&#2348;&#2306;&#2343;&#2367;&#2340; &#2361;&#2376;&#2306; &#2332;&#2376;&#2360;&#2375; &#2325;&#2367; &#2342;&#2368; &#2327;&#2312; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366; &#2332;&#2379;&#2337;&#2364;&#2368; &#2325;&#2368; &#2342;&#2379; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2319;&#2305; &#2360;&#2306;&#2348;&#2306;&#2343;&#2367;&#2340; &#2361;&#2376;&#2306;&#2404;</p><p>34 : 25</p></span>","options":["<span class=\"eqt\">28 - 12</span><span class=\"hqt\" style=\"display:none\">28 - 12</span>","<span class=\"eqt\">95 - 106</span><span class=\"hqt\" style=\"display:none\">95 - 106</span>","<span class=\"eqt\">50 - 30</span><span class=\"hqt\" style=\"display:none\">50 - 30</span>","<span class=\"eqt\">62 - 50</span><span class=\"hqt\" style=\"display:none\">62 - 50</span>"],"correct_option_id":1,"solution":"<p>3<sup>2</sup> + 4<sup>2</sup> = 9 + 16 = 25</p><p>Similarly,</p><p>9<sup>2</sup> + 5<sup>2</sup> = 81 + 25 = 106</p><p>So, among the given options, 95 - 106 is the correct option.</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>Select the set of numbers which is similar to the following set of numbers.</p><p>(10, 11, 42)</p></span><span class=\"hqt\" style=\"display:none\"><p>&#2320;&#2360;&#2368; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2323;&#2306; &#2325;&#2375; &#2360;&#2350;&#2370;&#2361; &#2325;&#2366; &#2330;&#2351;&#2344; &#2325;&#2352;&#2375;&#2306; &#2332;&#2379; &#2325;&#2367; &#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2323;&#2306; &#2325;&#2375; &#2360;&#2350;&#2370;&#2361; &#2325;&#2375; &#2309;&#2344;&#2369;&#2352;&#2370;&#2346; &#2361;&#2379;&#2306;&#2404;</p><p>(10, 11, 42)</p></span>","options":["<span class=\"eqt\">(2, 5, 20)</span><span class=\"hqt\" style=\"display:none\">(2, 5, 20)</span>","<span class=\"eqt\">(4, 5, 12)</span><span class=\"hqt\" style=\"display:none\">(4, 5, 12)</span>","<span class=\"eqt\">(6, 7, 26)</span><span class=\"hqt\" style=\"display:none\">(6, 7, 26)</span>","<span class=\"eqt\">(7, 8, 32)</span><span class=\"hqt\" style=\"display:none\">(7, 8, 32)</span>"],"correct_option_id":2,"solution":"<p>Third number = 2 x (addition of first 2 numbers)</p><p>Only option c follows the same logic. So, option c is the correct answer.</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>Select the option which has the pair of terms that is related to each other in the same way as the pair of terms given below.</p><p>PX : LU :: ?</p></span><span class=\"hqt\" style=\"display:none\"><p>&#2313;&#2360; &#2357;&#2367;&#2325;&#2354;&#2381;&#2346; &#2325;&#2366; &#2330;&#2351;&#2344; &#2325;&#2368;&#2332;&#2367;&#2319; &#2332;&#2367;&#2360;&#2350;&#2375;&#2306; &#2344;&#2368;&#2330;&#2375; &#2342;&#2367;&#2319; &#2327;&#2319; &#2346;&#2342;&#2379;&#2306; &#2325;&#2375; &#2351;&#2369;&#2327;&#2381;&#2350; &#2325;&#2375; &#2360;&#2350;&#2366;&#2344; &#2346;&#2342;&#2379;&#2306; &#2325;&#2366; &#2351;&#2369;&#2327;&#2381;&#2350; &#2361;&#2379;&#2404;</p><p>PX : LU :: ?</p></span>","options":["<span class=\"eqt\">DR : ZN</span><span class=\"hqt\" style=\"display:none\">DR : ZN</span>","<span class=\"eqt\">NI : KF</span><span class=\"hqt\" style=\"display:none\">NI : KF</span>","<span class=\"eqt\">YD : UA</span><span class=\"hqt\" style=\"display:none\">YD : UA</span>","<span class=\"eqt\">GW : BA</span><span class=\"hqt\" style=\"display:none\">GW : BA</span>"],"correct_option_id":2,"solution":"<p>P  -  4 = L, X  -  3 = U</p><p>Similarly,</p><p>Y  -  4 = U, D  -  3 = A</p><p>So, the term is YD : UA</p>","marks":2,"section":null}]}