ing: 0;\">1</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">a</span></div></div></p><p></p></span><span class=\"hqt\" style=\"display:none\"><p><div>&#2351;&#2342;&#2367; a = c +&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">1</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">2c</span></div>&nbsp;&#2361;&#2376;, &#2340;&#2379;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">1</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">a</span></div> &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</div></p></span>","options":["<span class=\"eqt\">2c/(4c<sup>2</sup> + 1)</span><span class=\"hqt\" style=\"display:none\">2c/(4c<sup>2</sup> + 1)</span>","<span class=\"eqt\">4c/(4c<sup>2</sup> + 1)</span><span class=\"hqt\" style=\"display:none\">4c/(4c<sup>2</sup> + 1)</span>","<span class=\"eqt\">2c/(2c<sup>2</sup> + 1)</span><span class=\"hqt\" style=\"display:none\">2c/(2c<sup>2</sup> + 1)</span>","<span class=\"eqt\">2c/(2c<sup>2</sup> + 2)</span><span class=\"hqt\" style=\"display:none\">2c/(2c<sup>2</sup> + 2)</span>"],"correct_option_id":2,"solution":"<p>a = c + 1/2c</p><p>a = (2c<sup>2</sup> + 1)/2c</p><p>Now a<sup>-1</sup> = 1/a = 1/[(2c<sup>2</sup> + 1)/2c] = 2c/(2c<sup>2</sup> + 1)</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>What value replaces \"?\" in [(3<sup>4</sup> &div; 9) + (5<sup>2</sup> &div; 5)] + (? &div; 2) = 30</p></span><span class=\"hqt\" style=\"display:none\"><p>[(3<sup>4</sup> &div; 9) + (5<sup>2</sup> &div; 5)] + (? &div; 2) = 30 &#2350;&#2375;&#2306; \"?\" &#2325;&#2375; &#2360;&#2381;&#2341;&#2366;&#2344; &#2346;&#2352; &#2325;&#2380;&#2344; &#2360;&#2366; &#2350;&#2366;&#2344; &#2310;&#2319;&#2327;&#2366;?</p></span>","options":["<span class=\"eqt\">24</span><span class=\"hqt\" style=\"display:none\">24</span>","<span class=\"eqt\">28</span><span class=\"hqt\" style=\"display:none\">28</span>","<span class=\"eqt\">30</span><span class=\"hqt\" style=\"display:none\">30</span>","<span class=\"eqt\">32</span><span class=\"hqt\" style=\"display:none\">32</span>"],"correct_option_id":3,"solution":"<p>3<sup>4</sup> = 81; 81 &div; 9 = 9</p><p>5<sup>2</sup> = 25; 25 &div; 5 = 5</p><p>9 + 5 = 14</p><p>14 + (? &div; 2) = 30 =&gt; ? &div; 2 = 16 =&gt; ? = 32</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>Evaluate for ?: [(&radic;4096 &div; 8) + (2<sup>4</sup> &div; 2)]  X  &#8731;? = 48</p></span><span class=\"hqt\" style=\"display:none\"><p>&#2325;&#2375; &#2354;&#2367;&#2319; &#2350;&#2370;&#2354;&#2381;&#2351;&#2366;&#2306;&#2325;&#2344; &#2325;&#2352;&#2375;&#2306;: [(&radic;4096 &div; 8) + (2<sup>4</sup> &div; 2)] X &#8731;? = 48</p></span>","options":["<span class=\"eqt\">27</span><span class=\"hqt\" style=\"display:none\">27</span>","<span class=\"eqt\">8</span><span class=\"hqt\" style=\"display:none\">8</span>","<span class=\"eqt\">18</span><span class=\"hqt\" style=\"display:none\">18</span>","<span class=\"eqt\">15</span><span class=\"hqt\" style=\"display:none\">15</span>"],"correct_option_id":0,"solution":"<p>&radic;4096 = 64; 64 &div; 8 = 8</p><p>2<sup>4</sup> = 16; 16 &div; 2 = 8</p><p>8 + 8 = 16</p><p>16  X  &#8731;? = 48 =&gt; &#8731;? = 3 =&gt; ? = 27</p>","marks":2,"section":null}]}