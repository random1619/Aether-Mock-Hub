B + C? </p></span><span class=\"hqt\" style=\"display:none\"><p>&#2351;&#2342;&#2367; (6X + Y)<sup>3</sup>  -  (X  -  6Y)<sup>3</sup> = (5X + 7Y) (AX<sup>2</sup> + CXY + BY<sup>2</sup>) &#2361;&#2376;, &#2340;&#2379; A + 2B + C &#2325;&#2366; &#2350;&#2366;&#2344; &#2325;&#2381;&#2351;&#2366; &#2361;&#2376;?</p></span>","options":["<span class=\"eqt\">70</span><span class=\"hqt\" style=\"display:none\">70</span>","<span class=\"eqt\">65</span><span class=\"hqt\" style=\"display:none\">65</span>","<span class=\"eqt\">75</span><span class=\"hqt\" style=\"display:none\">75</span>","<span class=\"eqt\">80</span><span class=\"hqt\" style=\"display:none\">80</span>"],"correct_option_id":0,"solution":"<p>(6X + Y)<sup>3</sup>  -  (X  -  6Y)<sup>3</sup> = (6X + Y  -  X + 6Y) [(6X + Y)<sup>2</sup> + (X  -  6Y)<sup>2</sup> + (6X + Y) (X  -  6Y)] </p><p>= (5X + 7Y) [36X<sup>2</sup> + Y<sup>2</sup> + 12XY + X<sup>2</sup> + 36Y<sup>2</sup>  -  12XY + 6X<sup>2</sup>  -  36XY + XY  -  6Y<sup>2</sup>] </p><p>= (5X + 7Y) [43X<sup>2</sup> + 31Y<sup>2</sup>  -  35XY] </p><p>So, A = 43 </p><p>B = 31 </p><p>C = -35 </p><p>A + 2B + C </p><p>=&gt; 43 + 2 * 31  -  35 </p><p>=&gt; 70 </p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>If Y = 4X + 3, then what is the value (64X<sup>3</sup>  -  Y<sup>3</sup> + 36XY)? </p></span><span class=\"hqt\" style=\"display:none\"><p>&#2351;&#2342;&#2367; Y = 4X + 3, &#2340;&#2379; (64X<sup>3</sup> - Y<sup>3</sup> + 36XY) &#2325;&#2366; &#2350;&#2366;&#2344; &#2325;&#2381;&#2351;&#2366; &#2361;&#2376;?</p></span>","options":["<span class=\"eqt\">27</span><span class=\"hqt\" style=\"display:none\">27</span>","<span class=\"eqt\">-27</span><span class=\"hqt\" style=\"display:none\">-27</span>","<span class=\"eqt\">-64</span><span class=\"hqt\" style=\"display:none\">-64</span>","<span class=\"eqt\">64</span><span class=\"hqt\" style=\"display:none\">64</span>"],"correct_option_id":1,"solution":"<p>4X  -  Y = -3 </p><p>=&gt; (4X  -  Y)<sup>3</sup> = -3<sup>3</sup></p><p>=&gt; 64X<sup>3</sup>  -  Y<sup>3</sup>  -  3 * 4XY (4X  -  Y) = -27 </p><p>=&gt; 64X<sup>3</sup>  -  Y<sup>3</sup> + 36XY = -27</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>If (a  -  b) = 1/4, then what is the value of (a<sup>3</sup>  -  b<sup>3</sup>)? </p></span><span class=\"hqt\" style=\"display:none\"><p>&#2351;&#2342;&#2367; (a - b) = 1/4, &#2340;&#2379; (a<sup>3</sup> - b<sup>3</sup>) &#2325;&#2366; &#2350;&#2366;&#2344; &#2325;&#2381;&#2351;&#2366; &#2361;&#2376;?</p></span>","options":["<span class=\"eqt\">4 * (a<sup>2</sup> + b<sup>2</sup> + 2ab)</span><span class=\"hqt\" style=\"display:none\">4* (&#2319;<sup>2</sup> + b<sup>2</sup> + 2ab)</span>","<span class=\"eqt\">(a<sup>2</sup> + b<sup>2</sup> + 2ab)/4</span><span class=\"hqt\" style=\"display:none\">(a<sup>2</sup> + b<sup>2</sup> + 2ab)/4</span>","<span class=\"eqt\">(a<sup>2</sup> + b<sup>2</sup> + ab)/4</span><span class=\"hqt\" style=\"display:none\">(a<sup>2</sup> + b<sup>2</sup> + ab)/4</span>","<span class=\"eqt\">4 * (a<sup>2</sup> + b<sup>2</sup> + ab)</span><span class=\"hqt\" style=\"display:none\">4* (&#2319;<sup>2</sup> + b<sup>2</sup> + ab)</span>"],"correct_option_id":2,"solution":"<p>a<sup>3</sup>  -  b<sup>3</sup> = (a  -  b) (a<sup>2</sup> + b<sup>2</sup> + ab) </p><p>= &#188; * (a<sup>2</sup> + b<sup>2</sup> + ab)</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>Find the coefficient of X<sup>3</sup>Y in (X + 4Y) * (3X + Y)<sup>3</sup>. </p></span><span class=\"hqt\" style=\"display:none\"><p>(X + 4Y) * (3X + Y)<sup>3</sup> &#2350;&#2375;&#2306; X<sup>3</sup>Y &#2325;&#2366; &#2327;&#2369;&#2339;&#2366;&#2306;&#2325; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p></span>","options":["<span class=\"eqt\">150</span><span class=\"hqt\" style=\"display:none\">150</span>","<span class=\"eqt\">180</span><span class=\"hqt\" style=\"display:none\">180</span>","<span class=\"eqt\">175</span><span class=\"hqt\" style=\"display:none\">175</span>","<span class=\"eqt\">135</span><span class=\"hqt\" style=\"display:none\">135</span>"],"correct_option_id":3,"solution":"<p>(X + 4Y) * (3X + Y)<sup>3</sup></p><p>=&gt; (X + 4Y) (27X<sup>3</sup> + Y<sup>3</sup> + 27X<sup>2</sup>Y + 9XY<sup>2</sup>)</p><p>=&gt; 27X<sup>4</sup> + XY<sup>3</sup> + 27X<sup>3</sup>Y +9X<sup>2</sup>Y<sup>2</sup> + 108X<sup>3</sup>Y + 4Y<sup>4</sup> + 108X<sup>2</sup>Y<sup>2</sup> + 36XY<sup>3</sup></p><p>So, the coefficient of X<sup>3</sup>Y = 135 </p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>If X - Y = 8 and X<sup>3</sup>  -  Y<sup>3</sup> = 1304, then find the value of X<sup>4</sup> + Y<sup>4 </sup>is: </p></span><span class=\"hqt\" style=\"display:none\"><p>&#2351;&#2342;&#2367; X - Y = 8 &#2324;&#2352; X<sup>3</sup> - Y<sup>3</sup> = 1304, &#2340;&#2379; X<sup>4</sup> + Y<sup>4</sup> &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;: </p></span>","options":["<span class=\"eqt\">14722</span><span class=\"hqt\" style=\"display:none\">14722</span>","<span class=\"eqt\">14920</span><span class=\"hqt\" style=\"display:none\">14920</span>","<span class=\"eqt\">14836</span><span class=\"hqt\" style=\"display:none\">14836</span>","<span class=\"eqt\">14638</span><span class=\"hqt\" style=\"display:none\">14638</span>"],"correct_option_id":0,"solution":"<p>X<sup>3</sup>  -  Y<sup>3</sup> = (X  -  Y) [(X  -  Y)<sup>2</sup> + 3XY] </p><p>1304 = 8 [8<sup>2</sup> + 3XY] </p><p>163 = 64 + 3XY </p><p>XY = 33</p><p>So, X = 11</p><p>Y = 3 </p><p>X<sup>4</sup> + Y<sup>4</sup> = 14641 + 81 </p><p>= 14722 </p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>If X<sup>2</sup> + 81Y<sup>2</sup> + 2X + 1 = 0, then find the value of X<sup>84 </sup>+ Y<sup>76</sup>. </p></span><span class=\"hqt\" style=\"display:none\"><p>&#2351;&#2342;&#2367; X<sup>2</sup> + 81Y<sup>2</sup> + 2X + 1 = 0, &#2340;&#2379; X<sup>84</sup>+ Y<sup>76</sup> &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p></span>","options":["<span class=\"eqt\">-1</span><span class=\"hqt\" style=\"display:none\">-1</span>","<span class=\"eqt\">1</span><span class=\"hqt\" style=\"display:none\">1</span>","<span class=\"eqt\">0</span><span class=\"hqt\" style=\"display:none\">0</span>","<span class=\"eqt\">-2</span><span class=\"hqt\" style=\"display:none\">-2</span>"],"correct_option_id":1,"solution":"<p>X<sup>2</sup> + 81Y<sup>2</sup> + 2X + 1 = 0</p><p>(X<sup>2</sup> + 2X + 1) + 81Y<sup>2</sup> = 0 </p><p>(X + 1)<sup>2</sup> + 81Y<sup>2</sup> = 0 </p><p>Since (X + 1)<sup>2</sup> &ge; 0 and 81Y<sup>2</sup> &ge; 0 </p><p>(X + 1)<sup>2</sup> = 0 </p><p>X = -1 </p><p>81Y<sup>2</sup> = 0 </p><p>Y = 0 </p><p>Hence, X<sup>84</sup> + Y<sup>76</sup> = 1 </p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>If X<sup>2</sup> + 16Y<sup>2</sup> + 6X + 9 = 0, then find the value of X<sup>4</sup> + Y<sup>16</sup>. </p></span><span class=\"hqt\" style=\"display:none\"><p>&#2351;&#2342;&#2367; X<sup>2</sup> + 16Y<sup>2</sup> + 6X + 9 = 0, &#2340;&#2379; X<sup>4</sup> + Y<sup>16</sup> &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p></span>","options":["<span class=\"eqt\">-81</span><span class=\"hqt\" style=\"display:none\">-81</span>","<span class=\"eqt\">64</span><span class=\"hqt\" style=\"display:none\">64</span>","<span class=\"eqt\">81</span><span class=\"hqt\" style=\"display:none\">81</span>","<span class=\"eqt\">-64</span><span class=\"hqt\" style=\"display:none\">-64</span>"],"correct_option_id":2,"solution":"<p>X<sup>2</sup> + 16Y<sup>2</sup> + 6X + 9 = 0</p><p>(X<sup>2</sup> + 6X + 9) + 16Y<sup>2</sup> = 0 </p><p>(X + 3)<sup>2</sup> + 16Y<sup>2</sup> = 0 </p><p>Since (X + 3)<sup>2</sup> &ge; 0 and 16Y<sup>2</sup> &ge; 0 </p><p>(X + 3)<sup>2</sup> = 0 </p><p>X = -3 </p><p>16Y<sup>2</sup> = 0 </p><p>Y = 0 </p><p>Hence, X<sup>4</sup> + Y<sup>16</sup> = 81 </p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>For what positive values of K do the following pair of linear equations have infinitely many solutions? </p><p>Kx + 9y  -  (K  -  9) = 0 </p><p>36x + Ky - K = 0 </p></span><span class=\"hqt\" style=\"display:none\"><p>K &#2325;&#2375; &#2325;&#2367;&#2360; &#2343;&#2344;&#2366;&#2340;&#2381;&#2350;&#2325; &#2350;&#2366;&#2344; &#2325;&#2375; &#2354;&#2367;&#2319; &#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2352;&#2376;&#2326;&#2367;&#2325; &#2360;&#2350;&#2368;&#2325;&#2352;&#2339; &#2351;&#2369;&#2327;&#2381;&#2350; &#2325;&#2375; &#2309;&#2344;&#2306;&#2340; &#2352;&#2370;&#2346; &#2360;&#2375; &#2309;&#2344;&#2375;&#2325; &#2361;&#2354; &#2361;&#2376;&#2306;?</p><p>Kx + 9y - (K - 9) = 0 </p><p>36x + Ky - K = 0 </p></span>","options":["<span class=\"eqt\">-9</span><span class=\"hqt\" style=\"display:none\">-9</span>","<span class=\"eqt\">-12</span><span class=\"hqt\" style=\"display:none\">-12</span>","<span class=\"eqt\">15</span><span class=\"hqt\" style=\"display:none\">15</span>","<span class=\"eqt\">18</span><span class=\"hqt\" style=\"display:none\">18</span>"],"correct_option_id":3,"solution":"<p>A<sub>1</sub>x + B<sub>1</sub>y + C<sub>1</sub> = 0 .. (i)</p><p>A<sub>2</sub>x + B<sub>2</sub>Y + C<sub>2</sub> = 0 ... (ii)</p><p>If eq 1 and 2 have infinite solutions then, </p><p>A<sub>1</sub>/A<sub>2</sub> = B<sub>1</sub>/B<sub>2</sub> = C<sub>1</sub>/C<sub>2</sub> (Constant) </p><p>Kx + 9y  -  (K  -  9) = 0 </p><p>36x + Ky - K = 0 </p><p>A<sub>1</sub> = K, B<sub>1</sub> = 9, C<sub>1</sub> =  -  K + 9 ... (iii)</p><p>A<sub>2</sub> = 36, B<sub>2</sub> = K, C<sub>2</sub> = -K ... (iv)</p><p>K/36 = 9/K </p><p>K = 18, -18</p><p>9/K = (-K + 9)/-K </p><p>9 = K  -  9</p><p>K = 18</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>For what positive values of K do the following pair of linear equations have infinitely many solutions? </p><p>Kx + 4y  -  (K  -  4) = 0 </p><p>16x + Ky - K = 0 </p></span><span class=\"hqt\" style=\"display:none\"><p>K &#2325;&#2375; &#2325;&#2367;&#2360; &#2343;&#2344;&#2366;&#2340;&#2381;&#2350;&#2325; &#2350;&#2366;&#2344; &#2325;&#2375; &#2354;&#2367;&#2319; &#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2352;&#2376;&#2326;&#2367;&#2325; &#2360;&#2350;&#2368;&#2325;&#2352;&#2339; &#2351;&#2369;&#2327;&#2381;&#2350; &#2325;&#2375; &#2309;&#2346;&#2352;&#2367;&#2350;&#2367;&#2340; &#2352;&#2370;&#2346; &#2360;&#2375; &#2309;&#2344;&#2375;&#2325; &#2361;&#2354; &#2361;&#2376;&#2306;?</p><p>Kx + 4y - (K - 4) = 0 </p><p>16x + Ky - K = 0 </p></span>","options":["<span class=\"eqt\">8</span><span class=\"hqt\" style=\"display:none\">8</span>","<span class=\"eqt\">6</span><span class=\"hqt\" style=\"display:none\">6</span>","<span class=\"eqt\">-4</span><span class=\"hqt\" style=\"display:none\">-4</span>","<span class=\"eqt\">-12</span><span class=\"hqt\" style=\"display:none\">-12</span>"],"correct_option_id":0,"solution":"<p>A<sub>1</sub>x + B<sub>1</sub>y + C<sub>1</sub> = 0 .. (i)</p><p>A<sub>2</sub>x + B<sub>2</sub>Y + C<sub>2</sub> = 0 ... (ii)</p><p>If eq 1 and 2 have infinite solutions then, </p><p>A<sub>1</sub>/A<sub>2</sub> = B<sub>1</sub>/B<sub>2</sub> = C<sub>1</sub>/C<sub>2</sub> (Constant) </p><p>Kx + 4y  -  (K  -  4) = 0 </p><p>16x + Ky - K = 0 </p><p>A<sub>1</sub> = K, B<sub>1</sub> = 4, C<sub>1</sub> =  -  K + 4 ... (iii)</p><p>A<sub>2</sub> = 16, B<sub>2</sub> = K, C<sub>2</sub> = -K ... (iv)</p><p>K/16 = 4/K </p><p>K = 8, -8</p><p>4/K = (-K + 4)/-K </p><p>4 = K  -  4 </p><p>K = 8 </p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>If there is no solution of the linear equation system kx  -  6y = 9, 12x + 2y = 8, then find the value of x. </p></span><span class=\"hqt\" style=\"display:none\"><p>&#2351;&#2342;&#2367; &#2352;&#2376;&#2326;&#2367;&#2325; &#2360;&#2350;&#2368;&#2325;&#2352;&#2339; &#2346;&#2381;&#2352;&#2339;&#2366;&#2354;&#2368; kx - 6y = 9, 12x + 2y = 8 &#2325;&#2366; &#2325;&#2379;&#2312; &#2361;&#2354; &#2344;&#2361;&#2368;&#2306; &#2361;&#2376;, &#2340;&#2379; x &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p></span>","options":["<span class=\"eqt\">18</span><span class=\"hqt\" style=\"display:none\">18</span>","<span class=\"eqt\">-36</span><span class=\"hqt\" style=\"display:none\">-36</span>","<span class=\"eqt\">-18</span><span class=\"hqt\" style=\"display:none\">-18</span>","<span class=\"eqt\">36</span><span class=\"hqt\" style=\"display:none\">36</span>"],"correct_option_id":1,"solution":"<p>If a<sub>1</sub>/a<sub>2</sub> = b<sub>1</sub>/b<sub>2</sub> &#8800; c<sub>1</sub>/c<sub>2</sub> </p><p>Here, a<sub>1</sub> = k, a<sub>2</sub> = 12, b<sub>1</sub> = -6, b<sub>2</sub> = 2 </p><p>k/12 = -6/2 </p><p>k = -36 </p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>If there is no solution of the linear equation system 18x  -  3y = 2, kx + 4y = 7, then find the value of x. </p></span><span class=\"hqt\" style=\"display:none\"><p>&#2351;&#2342;&#2367; &#2352;&#2376;&#2326;&#2367;&#2325; &#2360;&#2350;&#2368;&#2325;&#2352;&#2339; &#2346;&#2381;&#2352;&#2339;&#2366;&#2354;&#2368; 18x - 3y = 2, kx + 4y = 7 &#2325;&#2366; &#2325;&#2379;&#2312; &#2361;&#2354; &#2344;&#2361;&#2368;&#2306; &#2361;&#2376;, &#2340;&#2379; x &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p></span>","options":["<span class=\"eqt\">12</span><span class=\"hqt\" style=\"display:none\">12</span>","<span class=\"eqt\">-12</span><span class=\"hqt\" style=\"display:none\">-12</span>","<span class=\"eqt\">-24</span><span class=\"hqt\" style=\"display:none\">-24</span>","<span class=\"eqt\">24</span><span class=\"hqt\" style=\"display:none\">24</span>"],"correct_option_id":2,"solution":"<p>If a<sub>1</sub>/a<sub>2</sub> = b<sub>1</sub>/b<sub>2</sub> &#8800; c<sub>1</sub>/c<sub>2</sub> </p><p>Here, a<sub>1</sub> = 18, a<sub>2</sub> = k, b<sub>1</sub> = -3, b<sub>2</sub> = 4 </p><p>18/k = -3/4 </p><p>K = -24</p>","marks":2,"section":null},{"question":"<span class=\"eqt\"><p>x, y are two such positive numbers such that x &gt; y. If x<sup>4</sup> + y<sup>4</sup> = 1106 and xy = 13, then 2x + 3y = ? </p></span><span class=\"hqt\" style=\"display:none\"><p>x, y &#2342;&#2379; &#2320;&#2360;&#2368; &#2343;&#2344;&#2366;&#2340;&#2381;&#2350;&#2325; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2319;&#2305; &#2361;&#2376;&#2306; &#2332;&#2367;&#2360;&#2360;&#2375; x &gt; y. &#2351;&#2342;&#2367; x<sup>4</sup> + y<sup>4</sup> = 1106 &#2324;&#2352; xy = 13, &#2340;&#2379; 2x + 3y = ? </p></span>","options":["<span class=\"eqt\">20 + &radic;3</span><span class=\"hqt\" style=\"display:none\">20 + &radic;3</span>","<span class=\"eqt\">12 - &radic;3</span><span class=\"hqt\" style=\"display:none\">12 - &radic;3</span>","<span class=\"eqt\">12 + &radic;3</span><span class=\"hqt\" style=\"display:none\">12 + &radic;3</span>","<span class=\"eqt\">20 - &radic;3</span><span class=\"hqt\" style=\"display:none\">20 - &radic;3</span>"],"correct_option_id":3,"solution":"<p>X<sup>4</sup> + y<sup>4</sup> = 932</p><p>(x<sup>2</sup>)<sup>2</sup> + (y<sup>2</sup>)<sup>2</sup> + 2x<sup>2</sup>y<sup>2</sup> = 1106 + 2x<sup>2</sup>y<sup>2</sup></p><p>(x<sup>2</sup> + y<sup>2</sup>)<sup>2</sup> = 1106 + 2 * 13<sup>2</sup></p><p>x<sup>2</sup> + y<sup>2</sup> = 38 </p><p>x<sup>2</sup> + y<sup>2</sup> + 2xy = 38 + 2xy </p><p>(x + y)<sup>2</sup> = 38 + 2 * 13</p><p>x + y = 8 ...(i)</p><p>(x  -  y)<sup>2</sup> = x<sup>2</sup> + y<sup>2</sup>  -  2xy </p><p>= 12 </p><p>x  -  y = 2&radic;3 ... (ii)</p><p>From (i) and (ii)</p><p>x = 4 + &radic;3 </p><p>y = 4 - &radic;3 </p><p>So, 2&radic;x + 3y = 20 - &radic;3 </p>","marks":2,"section":null}]}